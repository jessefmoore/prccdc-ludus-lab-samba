{{ ansible_managed | comment }}
# Standalone SMB backup target (TrueNAS substitute).
[global]
   workgroup = {{ ccdc2_truenas_backup_workgroup }}
   server string = CCDC2 Backup NAS
   security = user
   map to guest = Bad User
   guest account = nobody
   log file = /var/log/samba/log.%m
   max log size = 1000
   server role = standalone server

[{{ ccdc2_truenas_backup_smb_share_name }}]
   comment = CCDC2 backup target
   path = {{ ccdc2_truenas_backup_share_path }}
   browseable = yes
   read only = no
   guest ok = yes
   force user = nobody
   create mask = 0664
   directory mask = 0775
