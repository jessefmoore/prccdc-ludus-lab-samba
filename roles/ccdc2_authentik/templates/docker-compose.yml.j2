# {{ ansible_managed }}
# authentik identity provider — server + worker + postgresql + redis.
# Structure follows the official goauthentik docker-compose, with the embedded
# LDAP outpost ports published so the SnipeIT host can authenticate SSH here.
---
services:
  postgresql:
    image: {{ ccdc2_authentik_postgres_image }}
    restart: unless-stopped
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -d $${POSTGRES_DB} -U $${POSTGRES_USER}"]
      start_period: 20s
      interval: 30s
      retries: 5
      timeout: 5s
    volumes:
      - database:/var/lib/postgresql/data
    environment:
      POSTGRES_PASSWORD: "{{ ccdc2_authentik_pg_password }}"
      POSTGRES_USER: authentik
      POSTGRES_DB: authentik

  redis:
    image: {{ ccdc2_authentik_redis_image }}
    command: --save 60 1 --loglevel warning
    restart: unless-stopped
    healthcheck:
      test: ["CMD-SHELL", "redis-cli ping | grep PONG"]
      start_period: 20s
      interval: 30s
      retries: 5
      timeout: 3s
    volumes:
      - redis:/data

  server:
    image: {{ ccdc2_authentik_image }}
    restart: unless-stopped
    command: server
    environment:
      AUTHENTIK_REDIS__HOST: redis
      AUTHENTIK_POSTGRESQL__HOST: postgresql
      AUTHENTIK_POSTGRESQL__USER: authentik
      AUTHENTIK_POSTGRESQL__NAME: authentik
      AUTHENTIK_POSTGRESQL__PASSWORD: "{{ ccdc2_authentik_pg_password }}"
      AUTHENTIK_SECRET_KEY: "{{ ccdc2_authentik_secret_key }}"
      AUTHENTIK_BOOTSTRAP_PASSWORD: "{{ ccdc2_authentik_bootstrap_password }}"
      AUTHENTIK_BOOTSTRAP_TOKEN: "{{ ccdc2_authentik_bootstrap_token }}"
      AUTHENTIK_BOOTSTRAP_EMAIL: "{{ ccdc2_authentik_bootstrap_email }}"
    volumes:
      - ./media:/media
      - ./custom-templates:/templates
      - ./blueprints/ccdc2:/blueprints/ccdc2
    ports:
      - "{{ ccdc2_authentik_http_port }}:9000"
      - "{{ ccdc2_authentik_https_port }}:9443"
    depends_on:
      postgresql:
        condition: service_healthy
      redis:
        condition: service_healthy

  worker:
    image: {{ ccdc2_authentik_image }}
    restart: unless-stopped
    command: worker
    environment:
      AUTHENTIK_REDIS__HOST: redis
      AUTHENTIK_POSTGRESQL__HOST: postgresql
      AUTHENTIK_POSTGRESQL__USER: authentik
      AUTHENTIK_POSTGRESQL__NAME: authentik
      AUTHENTIK_POSTGRESQL__PASSWORD: "{{ ccdc2_authentik_pg_password }}"
      AUTHENTIK_SECRET_KEY: "{{ ccdc2_authentik_secret_key }}"
      AUTHENTIK_BOOTSTRAP_PASSWORD: "{{ ccdc2_authentik_bootstrap_password }}"
      AUTHENTIK_BOOTSTRAP_TOKEN: "{{ ccdc2_authentik_bootstrap_token }}"
      AUTHENTIK_BOOTSTRAP_EMAIL: "{{ ccdc2_authentik_bootstrap_email }}"
    user: root
    volumes:
      - ./media:/media
      - ./certs:/certs
      - ./custom-templates:/templates
      - ./blueprints/ccdc2:/blueprints/ccdc2
      - /var/run/docker.sock:/var/run/docker.sock
    depends_on:
      postgresql:
        condition: service_healthy
      redis:
        condition: service_healthy

volumes:
  database:
    driver: local
  redis:
    driver: local
